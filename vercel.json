{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://myshopping-api.onrender.com/:path*"
    },
    {
      "source": "/backend/:path*",
      "destination": "https://myshopping-api.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
